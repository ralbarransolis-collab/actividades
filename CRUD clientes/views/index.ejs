<%- include("partials/head", { titulo }) %>
<%- include("partials/navbar") %>

<main class="container flex-grow-1 py-5">
    <section class="mb-4">
        <h1 class="display-6 fw-bold">Administración de clientes</h1>
    </section>

    <div id="alerta" aria-live="polite"></div>

    <section class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                <div>
                    <h2 class="h4 mb-1">Consultar clientes</h2>
                    <p class="text-secondary mb-0">
                        Obtiene todos los registros ordenados por nombre. La información aparecerá abajod e los módulos.
                    </p>
                </div>

                <form id="formConsultar">
                    <button class="btn btn-primary" type="submit">
                        Consultar clientes
                    </button>
                </form>
            </div>
        </div>
    </section>

    <section class="row g-4 mb-4">
        <div class="col-lg-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body p-4">
                    <h2 class="h4">Crear cliente</h2>
                    <form id="formCrear" class="row g-3">
                        <div class="col-12">
                            <label for="crearRut" class="form-label">RUT</label>
                            <input id="crearRut" class="form-control" type="text" required>
                        </div>
                        <div class="col-12">
                            <label for="crearNombre" class="form-label">Nombre</label>
                            <input id="crearNombre" class="form-control" type="text" required>
                        </div>
                        <div class="col-12">
                            <label for="crearEdad" class="form-label">Edad</label>
                            <input id="crearEdad" class="form-control" type="number" min="0" step="1" required>
                        </div>
                        <div class="col-12">
                            <button class="btn btn-success w-100" type="submit">
                                Crear cliente
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body p-4">
                    <h2 class="h4">Modificar nombre</h2>
                    <form id="formModificar" class="row g-3">
                        <div class="col-12">
                            <label for="modificarRut" class="form-label">RUT</label>
                            <input id="modificarRut" class="form-control" type="text" required>
                        </div>
                        <div class="col-12">
                            <label for="modificarNombre" class="form-label">Nuevo nombre</label>
                            <input id="modificarNombre" class="form-control" type="text" required>
                        </div>
                        <div class="col-12">
                            <button class="btn btn-warning w-100" type="submit">
                                Modificar nombre
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body p-4">
                    <h2 class="h4">Eliminar cliente</h2>
                    <form id="formEliminar" class="row g-3">
                        <div class="col-12">
                            <label for="eliminarRut" class="form-label">RUT</label>
                            <input id="eliminarRut" class="form-control" type="text" required>
                        </div>
                        <div class="col-12">
                            <button class="btn btn-danger w-100" type="submit">
                                Eliminar cliente
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <section class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="h4 mb-0">Resultados</h2>
                <span id="cantidadClientes" class="badge text-bg-primary">0 clientes</span>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>RUT</th>
                            <th>Nombre</th>
                            <th>Edad</th>
                        </tr>
                    </thead>
                    <tbody id="tablaClientes">
                        <tr>
                            <td colspan="4" class="text-center text-secondary py-4">
                                Presiona “Consultar clientes” para cargar los registros.
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </section>
</main>

<script src="/js/app.js"></script>
<%- include("partials/footer") %>
