<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Proveedores</title>

    <!-- Bootstrap -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <!-- Iconos de Bootstrap -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
        rel="stylesheet"
    >

    <!-- Estilos propios -->
    <link rel="stylesheet" href="/css/estilos.css">
</head>

<body>

    <header class="text-white py-4">

        <div class="container">

            <h1 class="h3 mb-1">
                Empresa
            </h1>

            <p class="mb-0 text-white-50">
                Registro de proveedores
            </p>

        </div>

    </header>

    <main class="container py-5">

        <!-- Mensaje de operación exitosa -->
        <% if (mensaje) { %>

            <div
                class="alert alert-success alert-dismissible fade show"
                role="alert"
            >
                <i class="bi bi-check-circle-fill me-2"></i>

                <%= mensaje %>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar"
                ></button>
            </div>

        <% } %>

        <!-- Mensaje de error -->
        <% if (error) { %>

            <div
                class="alert alert-danger alert-dismissible fade show"
                role="alert"
            >
                <i class="bi bi-exclamation-triangle-fill me-2"></i>

                <%= error %>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar"
                ></button>
            </div>

        <% } %>

        <div class="row g-4">

            <!-- Formulario para registrar proveedores -->
            <div class="col-lg-4">

                <div class="card border-0 shadow-sm">

                    <div class="card-body p-4">

                        <h2 class="h5 mb-1">
                            Registrar proveedor
                        </h2>

                        <p class="text-secondary small mb-4">
                            Ingrese los datos del proveedor
                        </p>

                        <form action="/proveedores" method="post">

                            <div class="mb-3">

                                <label
                                    for="nombre"
                                    class="form-label"
                                >
                                    Nombre
                                </label>

                                <input
                                    type="text"
                                    id="nombre"
                                    name="nombre"
                                    class="form-control"
                                    placeholder="Ingrese el nombre"
                                    required
                                >

                            </div>

                            <div class="mb-3">

                                <label
                                    for="direccion"
                                    class="form-label"
                                >
                                    Dirección
                                </label>

                                <input
                                    type="text"
                                    id="direccion"
                                    name="direccion"
                                    class="form-control"
                                    placeholder="Ingrese la dirección"
                                    required
                                >

                            </div>

                            <div class="mb-3">

                                <label
                                    for="telefono"
                                    class="form-label"
                                >
                                    Teléfono
                                </label>

                                <input
                                    type="tel"
                                    id="telefono"
                                    name="telefono"
                                    class="form-control"
                                    placeholder="Ej: +56 9 1234 5678"
                                    pattern="\+?[0-9 ]{9,15}"
                                    required
                                >

                            </div>

                            <div class="mb-3">

                                <label
                                    for="email"
                                    class="form-label"
                                >
                                    Correo electrónico
                                </label>

                                <input
                                    type="email"
                                    id="email"
                                    name="email"
                                    class="form-control"
                                    placeholder="Ingrese el correo electrónico"
                                    required
                                >

                            </div>

                            <button
                                type="submit"
                                class="btn btn-primary w-100"
                            >
                                <i class="bi bi-person-plus-fill me-1"></i>
                                Registrar proveedor
                            </button>

                        </form>

                    </div>

                </div>

            </div>

            <!-- Tabla de proveedores -->
            <div class="col-lg-8">

                <div class="card border-0 shadow-sm">

                    <div class="card-body p-4">

                        <h2 class="h5 mb-4">
                            Listado de proveedores
                        </h2>

                        <% if (proveedores.length > 0) { %>

                            <div class="table-responsive">

                                <table class="table table-hover align-middle mb-0">

                                    <thead class="encabezado">

                                        <tr>
                                            <th>ID</th>
                                            <th>Nombre</th>
                                            <th>Dirección</th>
                                            <th>Teléfono</th>
                                            <th>E-mail</th>
                                            <th class="text-center">
                                                Acciones
                                            </th>
                                        </tr>

                                    </thead>

                                    <tbody>

                                        <% proveedores.forEach(proveedor => { %>

                                            <tr>

                                                <td>
                                                    <%= proveedor.id %>
                                                </td>

                                                <td>
                                                    <%= proveedor.nombre %>
                                                </td>

                                                <td>
                                                    <%= proveedor.direccion %>
                                                </td>

                                                <td>
                                                    <%= proveedor.telefono %>
                                                </td>

                                                <td>
                                                    <%= proveedor.email %>
                                                </td>

                                                <td>

                                                    <div class="d-flex justify-content-center gap-2">

                                                        <a
                                                            href="/proveedores/editar/<%= proveedor.id %>"
                                                            class="btn btn-warning btn-sm"
                                                        >
                                                            <i class="bi bi-pencil-fill"></i>
                                                            Editar
                                                        </a>

                                                        <form
                                                            action="/proveedores/eliminar/<%= proveedor.id %>"
                                                            method="post"
                                                            onsubmit="return confirm('¿Está seguro de eliminar este proveedor?')"
                                                        >
                                                            <button
                                                                type="submit"
                                                                class="btn btn-danger btn-sm"
                                                            >
                                                                <i class="bi bi-trash-fill"></i>
                                                                Eliminar
                                                            </button>
                                                        </form>

                                                    </div>

                                                </td>

                                            </tr>

                                        <% }); %>

                                    </tbody>

                                </table>

                            </div>

                        <% } else { %>

                            <div class="alert alert-warning mb-0">

                                <i class="bi bi-info-circle-fill me-2"></i>

                                No existen proveedores registrados.

                            </div>

                        <% } %>

                    </div>

                </div>

            </div>

        </div>

        <div class="mt-4">

            <a
                href="/"
                class="btn btn-secondary"
            >
                <i class="bi bi-people-fill me-1"></i>
                Ir a empleados
            </a>

        </div>

    </main>

    <!-- JavaScript de Bootstrap -->
    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
    ></script>

</body>

</html>