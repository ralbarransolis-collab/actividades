<section class="formulario-seccion">
    <div>
        <p class="etiqueta">Escríbenos</p>
        <h1>Formulario de contacto</h1>
        <p>Completa tus datos y envíanos tu mensaje.</p>
    </div>

    {{#if error}}
        <p class="mensaje-error">{{error}}</p>
    {{/if}}

    <form class="formulario" action="/contact" method="POST">
        <div class="campo">
            <label for="nombre">Nombre</label>
            <input
                type="text"
                id="nombre"
                name="nombre"
                value="{{datos.nombre}}"
                required
            >
        </div>

        <div class="campo">
            <label for="correo">Correo electrónico</label>
            <input
                type="email"
                id="correo"
                name="correo"
                value="{{datos.correo}}"
                required
            >
        </div>

        <div class="campo">
            <label for="mensaje">Mensaje</label>
            <textarea
                id="mensaje"
                name="mensaje"
                rows="6"
                required
            >{{datos.mensaje}}</textarea>
        </div>

        <button class="boton" type="submit">Enviar mensaje</button>
    </form>
</section>
