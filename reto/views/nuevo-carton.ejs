<%- include('partials/head', { titulo }) %>
<%- include('partials/navbar') %>

<main class="container flex-grow-1 py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <section class="card border-0 shadow-sm">
                <div class="card-body p-4 p-md-5">
                    <h1 class="h2 fw-bold">Crear un nuevo cartón</h1>
                    <p class="text-secondary">
                        No necesitas ingresar números. El servidor generará automáticamente
                        15 números diferentes entre 1 y 30.
                    </p>

                    <button id="btnCrear" class="btn btn-success btn-lg" type="button">
                        Generar nuevo cartón
                    </button>

                    <div id="mensaje" class="mt-4" aria-live="polite"></div>
                    <div id="resultado" class="mt-4"></div>
                </div>
            </section>
        </div>
    </div>
</main>

<script src="/js/nuevo-carton.js"></script>
<%- include('partials/footer') %>
