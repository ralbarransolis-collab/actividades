<!DOCTYPE html>
<html lang="es">

<head>
    <%- include("partials/header") %>
</head>

<body>
    <%- include("partials/navbar") %>

    <header class="text-light text-center py-4 mt-5">
        <h1 class="sombra-titulo">
            Adivina el Número
        </h1>

        <h3 class="mb-0">
            Intenta descubrir el número secreto
        </h3>
    </header>

    <main class="container my-3">

        <div class="row justify-content-center">

            <div class="col-md-7 col-lg-5">

                <div class="card shadow">

                    <div class="card-body p-4">

                        <h2 class="card-title text-center mb-4">
                            Nueva partida
                        </h2>

                        <p>
                            El sistema elegirá un número secreto entre <strong>1 y 10</strong>.
                        </p>

                        <p>
                            Tienes un máximo de <strong>cinco intentos</strong> para adivinarlo.
                        </p>

                        <p>
                            Si aciertas en el <strong>primer intento</strong> obtienes <strong>3 puntos</strong>.
                            Si aciertas entre el <strong>segundo</strong> y el <strong>quinto intento</strong>,
                            obtienes <strong>1 punto</strong>.
                        </p>

                        <% if (mensaje !== "") { %>

                            <div class="alert alert-warning" role="alert">
                                <%= mensaje %>
                            </div>

                        <% } %>

                        <form action="/comenzar" method="POST">

                            <div class="mb-3">

                                <label for="nombre" class="form-label">Nombre del jugador</label>

                                <input type="text" id="nombre" name="nombre" class="form-control" placeholder="Ingrese su nombre" required>

                            </div>

                            <button type="submit" class="btn btn-primary w-100">Comenzar partida</button>

                        </form>

                        <div class="text-center mt-3">

                            <a href="/historial" class="btn btn-outline-dark">Consultar historial</a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </main>
 <%- include("partials/footer") %>
</body>

</html>