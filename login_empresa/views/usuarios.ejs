<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Usuarios</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

   <link rel="stylesheet" href="/style.css">
</head>

<body class="fondo">

    <%- include('partials/navbar') %>

       <header class="text-white  text-center py-4">
            <div class="container">

                <h1 class="h2 mb-1">
                    Nueva Empresa
                </h1>

            </div>
    </header>

        <main class="container py-5">

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">

                <div>
                    <h1 class="h3 fw-bold mb-1">
                        Usuarios registrados
                    </h1>

                    <p class="text-secondary mb-0">
                        Listado de usuarios almacenados en la base de datos
                    </p>
                </div>

                <span class="badge text-bg-dark fs-6 mt-3 mt-md-0">
                    Total: <%= usuarios.length %>
                </span>

            </div>
            <div class="row g-4">

                <div class="col-md-7">
                    <div class="card border-0 shadow h-100">

                        <div class="card-body p-0">

                            <% if (usuarios.length> 0) { %>

                                <div class="table-responsive">

                                    <table class="table table-hover align-middle mb-0">

                                        <thead class="table-dark">
                                            <tr>
                                                <th class="px-4 py-3">ID</th>
                                                <th class="px-4 py-3">Nombre</th>
                                                <th class="px-4 py-3">Correo</th>
                                                <th class="px-4 py-3">Acciones</th>
                                            </tr>
                                        </thead>

                                        <tbody>

                                            <% usuarios.forEach(usuario=> { %>

                                                <tr>

                                                    <td class="px-4 py-3">
                                                        <span class="badge text-bg-secondary">
                                                            <%= usuario.id %>
                                                        </span>
                                                    </td>

                                                    <td class="px-4 py-3 fw-semibold">
                                                        <%= usuario.nombre %>
                                                    </td>

                                                    <td class="px-4 py-3">
                                                        <a href="mailto:<%= usuario.correo %>"
                                                            class="text-decoration-none">
                                                            <%= usuario.correo %>
                                                        </a>
                                                    </td>
                                                    <td class="px-4 py-3">
                                                        <a href="/usuarios/editar/<%= usuario.id %>"
                                                            class="btn btn-success btn-sm">
                                                            Editar
                                                        </a>

                                                        <form action="/usuarios/eliminar/<%= usuario.id %>"
                                                            method="post" class="d-inline"
                                                            onsubmit="return confirm('¿Está seguro de eliminar este usuario?')">
                                                            <button type="submit" class="btn btn-danger btn-sm">
                                                                Eliminar
                                                            </button>
                                                        </form>
                                                    </td>

                                                </tr>

                                                <% }); %>

                                        </tbody>

                                    </table>

                                </div>

                                <% } else { %>

                                    <div class="text-center py-5">

                                        <h2 class="h5 fw-semibold">
                                            No hay usuarios registrados
                                        </h2>

                                        <p class="text-secondary mb-0">
                                            Actualmente no existen usuarios para mostrar.
                                        </p>

                                    </div>

                                    <% } %>

                        </div>

                    </div>
                </div>

                <div class="col-md-5">

                    <div class="card border-0 shadow h-100">

                        <div class="card-body p-4">

                            <h2 class="h4 mb-4">
                                Crear usuario de correo
                            </h2>
                            <% if (mensaje) { %>

                                <div class="alert alert-success alert-dismissible fade show" role="alert">
                                    <i class="bi bi-check-circle-fill me-2"></i>

                                    <%= mensaje %>

                                        <button type="button" class="btn-close" data-bs-dismiss="alert"
                                            aria-label="Cerrar"></button>
                                </div>

                                <% } %>

                                    <% if (error) { %>

                                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                            <i class="bi bi-exclamation-triangle-fill me-2"></i>

                                            <%= error %>

                                                <button type="button" class="btn-close" data-bs-dismiss="alert"
                                                    aria-label="Cerrar"></button>
                                        </div>

                                        <% } %>
                                            <form action="/usuarios" method="post">
                                                <div class="mb-3">
                                                    <label for="nombre" class="form-label fw-semibold">
                                                        Nombre
                                                    </label>

                                                    <input type="text" id="nombre" name="nombre" class="form-control"
                                                        placeholder="Ingrese el nombre" maxlength="100"
                                                        autocomplete="name" required>
                                                </div>
                                                <div class="mb-3">
                                                    <label for="correo" class="form-label fw-semibold">
                                                        Correo
                                                    </label>

                                                    <input type="email" id="correo" name="correo" class="form-control"
                                                        placeholder="Ingrese el correo" maxlength="100" required>
                                                </div>
                                                <div class="mb-3">
                                                    <label for="password"
                                                        class="form-label fw-semibold">Contraseña</label>
                                                    <input type="password" name="password" minlength="6"
                                                        placeholder="min. 6 carácteres" required>
                                                </div>
                                                <div>
                                                    <button type="submit" class="btn btn-primary"><i
                                                            class="bi bi-envelope me-1"></i>Crear correo</button>
                                                </div>
                                            </form>
                        </div>

                    </div>

                </div>

            </div>
        </main>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>