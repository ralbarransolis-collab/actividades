<%- include("partials/head", { titulo }) %>
<%- include("partials/navbar") %>

<main class="container flex-grow-1 py-5">
    <section class="mb-4">
        <h1 class="display-6 fw-bold">Administración de clientes</h1>
        <p class="lead text-secondary mb-0">
            Crear, consultar, modificar y eliminar mediante consultas parametrizadas.
        </p>
    </section>

    <div id="alerta" aria-live="polite"></div>

    <section class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3">
                <div>
                    <h2 class="h4 mb-1">Resultados</h2>
                    <p id="resumenResultados" class="text-secondary mb-0">
                        Utiliza alguno de los formularios de consulta.
                    </p>
                </div>
                <button id="btnListarTodos" class="btn btn-primary" type="button">
                    Listar todos
                </button>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">#</th>
                            <th scope="col">RUT</th>
                            <th scope="col">Nombre</th>
                            <th scope="col">Edad</th>
                        </tr>
                    </thead>
                    <tbody id="tablaClientes">
                        <tr>
                            <td colspan="4" class="text-center text-secondary py-4">
                                Aún no se han cargado resultados.
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <section class="row g-4 mb-4">
        <div class="col-xl-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body p-4">
                    <h2 class="h4">Crear cliente</h2>
                    <form id="formCrear" class="row g-3">
                        <div class="col-12">
                            <label for="crearRut" class="form-label">RUT</label>
                            <input id="crearRut" type="text" class="form-control" required>
                        </div>
                        <div class="col-12">
                            <label for="crearNombre" class="form-label">Nombre</label>
                            <input id="crearNombre" type="text" class="form-control" required>
                        </div>
                        <div class="col-12">
                            <label for="crearEdad" class="form-label">Edad</label>
                            <input id="crearEdad" type="number" min="0" class="form-control" required>
                        </div>
                        <div class="col-12">
                            <button class="btn btn-success" type="submit">Crear cliente</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-xl-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body p-4">
                    <h2 class="h4">Modificar nombre</h2>
                    <form id="formModificar" class="row g-3">
                        <div class="col-12">
                            <label for="modificarRut" class="form-label">RUT del cliente</label>
                            <input id="modificarRut" type="text" class="form-control" required>
                        </div>
                        <div class="col-12">
                            <label for="modificarNombre" class="form-label">Nuevo nombre</label>
                            <input id="modificarNombre" type="text" class="form-control" required>
                        </div>
                        <div class="col-12">
                            <button class="btn btn-warning" type="submit">Modificar nombre</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-xl-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body p-4">
                    <h2 class="h4">Eliminar por RUT</h2>
                    <form id="formEliminarRut" class="row g-3">
                        <div class="col-12">
                            <label for="eliminarRut" class="form-label">RUT</label>
                            <input id="eliminarRut" type="text" class="form-control" required>
                        </div>
                        <div class="col-12">
                            <button class="btn btn-danger" type="submit">Eliminar cliente</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <section class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <h2 class="h4 mb-3">Consultas por criterios</h2>
            <div class="row g-4">
                <div class="col-lg-6 col-xl-3">
                    <form id="formConsultarRut" class="h-100 border rounded p-3 bg-body-tertiary">
                        <h3 class="h6">Por RUT</h3>
                        <input id="consultarRut" type="text" class="form-control mb-3" required>
                        <button class="btn btn-outline-primary w-100" type="submit">Consultar RUT</button>
                    </form>
                </div>

                <div class="col-lg-6 col-xl-3">
                    <form id="formConsultarEdad" class="h-100 border rounded p-3 bg-body-tertiary">
                        <h3 class="h6">Por edad exacta</h3>
                        <input id="consultarEdad" type="number" min="0" class="form-control mb-3" required>
                        <button class="btn btn-outline-primary w-100" type="submit">Consultar edad</button>
                    </form>
                </div>

                <div class="col-lg-6 col-xl-3">
                    <form id="formConsultarRango" class="h-100 border rounded p-3 bg-body-tertiary">
                        <h3 class="h6">Por rango de edad</h3>
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <input id="consultarEdadMin" type="number" min="0" class="form-control" placeholder="Mínima" required>
                            </div>
                            <div class="col-6">
                                <input id="consultarEdadMax" type="number" min="0" class="form-control" placeholder="Máxima" required>
                            </div>
                        </div>
                        <button class="btn btn-outline-primary w-100" type="submit">Consultar rango</button>
                    </form>
                </div>

                <div class="col-lg-6 col-xl-3">
                    <form id="formConsultarNombre" class="h-100 border rounded p-3 bg-body-tertiary">
                        <h3 class="h6">Por nombre o prefijo</h3>
                        <input id="consultarNombre" type="text" class="form-control mb-3" required>
                        <button class="btn btn-outline-primary w-100" type="submit">Consultar nombre</button>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <section class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <h2 class="h4 mb-3">Eliminaciones por criterio</h2>
            <div class="row g-4">
                <div class="col-lg-6">
                    <form id="formEliminarEdad" class="border rounded p-3 bg-body-tertiary">
                        <label for="eliminarEdad" class="form-label fw-semibold">Eliminar todos con una edad</label>
                        <div class="input-group">
                            <input id="eliminarEdad" type="number" min="0" class="form-control" required>
                            <button class="btn btn-outline-danger" type="submit">Eliminar por edad</button>
                        </div>
                    </form>
                </div>

                <div class="col-lg-6">
                    <form id="formEliminarRango" class="border rounded p-3 bg-body-tertiary">
                        <label class="form-label fw-semibold">Eliminar dentro de un rango</label>
                        <div class="row g-2">
                            <div class="col-sm-4">
                                <input id="eliminarEdadMin" type="number" min="0" class="form-control" placeholder="Mínima" required>
                            </div>
                            <div class="col-sm-4">
                                <input id="eliminarEdadMax" type="number" min="0" class="form-control" placeholder="Máxima" required>
                            </div>
                            <div class="col-sm-4 d-grid">
                                <button class="btn btn-danger" type="submit">Eliminar rango</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>
</main>

<script src="/js/app.js"></script>
<%- include("partials/footer") %>
