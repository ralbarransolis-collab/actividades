<!DOCTYPE html>
<html lang="es">

<head>
    <%- include("partials/header") %>
</head>

<body>
    <%- include("partials/navbar") %>
    <header class="text-light text-center py-4">

        <h1 class="sombra-titulo">
            Configuración
        </h1>

    </header>

    <main class="container my-5">

        <div class="row justify-content-center">

            <div class="col-md-6">

                <% if (mensaje !== "") { %>

                    <div class="alert alert-success">
                        <%= mensaje %>
                    </div>

                <% } %>

                <div class="card shadow">

                    <div class="card-body text-center">

                        <h2>
                            Reiniciar historial
                        </h2>

                        <p>
                            Esta acción eliminará todas las partidas registradas.
                        </p>

                        <form action="/reiniciar-historial" method="POST">

                            <button
                                type="submit"
                                class="btn btn-danger"
                            >
                                Reiniciar historial
                            </button>

                        </form>

                    </div>

                </div>

                <div class="text-center mt-4">

                    <a href="/" class="btn btn-outline-dark">
                        Volver al inicio
                    </a>

                </div>

            </div>

        </div>

    </main>

</body>

</html>