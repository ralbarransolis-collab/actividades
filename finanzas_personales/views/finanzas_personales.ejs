<%- include('partials/head') %>

  <%- include('partials/navbar') %>  

    <main class="container flex-grow-1 py-5">

        <section class="mb-4">
            <h1 class="display-6 fw-bold">
                Finanzas personales
            </h1>

            <p class="text-secondary mb-0">
                Registro personal de deudas y cobranzas, con sus respectivas cuotas.
            </p>
        </section>

        <% if (mensaje) { %>
            <div class="alert alert-success">
                <%= mensaje %>
            </div>
        <% } %>

        <% if (error) { %>
            <div class="alert alert-danger">
                <%= error %>
            </div>
        <% } %>

        <section class="card border-0 shadow-sm">

            <div class="card-header bg-white py-3">
                <div
                    class="d-flex justify-content-between
                           align-items-center"
                >
                    <div>
                        <h2 class="h4 mb-1">
                            Registros financieros
                        </h2>

                        <p class="text-secondary mb-0">
                            Cantidad de registros:
                            <strong>
                                <%= finanzas_personales.length %>
                            </strong>
                        </p>
                    </div>

                    <a href="/" class="btn btn-outline-primary">
                        Actualizar
                    </a>
                </div>
            </div>

            <div class="card-body p-0">

                <% if (finanzas_personales.length === 0) { %>

                    <div class="alert alert-warning m-4">
                        No existen registros en la tabla
                        <strong>finanzas_personales</strong>.
                    </div>

                <% } else { %>

                    <div class="table-responsive">

                        <table
                            class="table table-hover
                                   table-bordered align-middle mb-0"
                        >

                            <thead class="table-primary">
                                <tr>
                                    <th scope="col">Nombre</th>
                                    <th scope="col" class="text-end">
                                        Me debe
                                    </th>
                                    <th scope="col" class="text-center">
                                        Cuotas por cobrar
                                    </th>
                                    <th scope="col" class="text-end">
                                        Le debo
                                    </th>
                                    <th scope="col" class="text-center">
                                        Cuotas por pagar
                                    </th>
                                </tr>
                            </thead>

                            <tbody>

                                <% finanzas_personales.forEach((registro) => { %>

                                    <tr>
                                        <td class="fw-semibold">
                                            <%= registro.nombre %>
                                        </td>

                                        <td class="text-end text-success">
                                            $<%= Number(registro.me_debe)
                                                .toLocaleString("es-CL") %>
                                        </td>

                                        <td class="text-center">
                                            <%= registro.cuotas_cobrar %>
                                        </td>

                                        <td class="text-end text-danger">
                                            $<%= Number(registro.le_debo)
                                                .toLocaleString("es-CL") %>
                                        </td>

                                        <td class="text-center">
                                            <%= registro.cuotas_pagar %>
                                        </td>
                                    </tr>

                                <% }) %>

                            </tbody>

                        </table>

                    </div>

                <% } %>

            </div>
        </section>

    </main>

   <%- include('partials/footer') %>