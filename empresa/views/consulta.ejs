<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Consulta</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Iconos de Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <!-- CSS personalizado -->
    <link rel="stylesheet" href="/css/estilos.css">
</head>

<body>
    <%- include("partials/navbar") %>
        <header class="text-white py-4 encabezado">

            <div class="container">

                <h1 class="h3 mb-1">
                    Empresa
                </h1>

                <p class="mb-0 text-white-50">
                    Consulta de empleados
                </p>

            </div>

        </header>

        <main class="container py-5">

            <div class="row justify-content-center">

                <div class="col-lg-10">

                    <!-- Formulario de consulta -->
                    <div class="card border-0 shadow-sm mb-4">

                        <div class="card-body p-4">

                            <h2 class="h5 mb-1">
                                Buscar empleados
                            </h2>

                            <p class="text-secondary small mb-4">
                                Puede filtrar por cargo y sueldo mínimo
                            </p>

                            <form action="/consulta" method="post">

                                <div class="row g-3">

                                    <div class="col-md-5">

                                        <label for="cargo" class="form-label">
                                            Cargo
                                        </label>

                                        <input id="cargo" name="cargo" type="text" class="form-control"
                                            value="<%= cargo %>" placeholder="Ejemplo: vendedor">

                                    </div>

                                    <div class="col-md-4">

                                        <label for="sueldoMinimo" class="form-label">
                                            Sueldo mínimo
                                        </label>

                                        <input id="sueldoMinimo" name="sueldoMinimo" type="number" class="form-control"
                                            value="<%= sueldoMinimo %>" min="0" step="1">

                                    </div>

                                    <div class="col-md-3 d-flex align-items-end">

                                        <button type="submit" class="btn btn-primary w-100">
                                            <i class="bi bi-search me-1"></i>
                                            Consultar
                                        </button>

                                    </div>

                                </div>

                            </form>

                        </div>

                    </div>

                    <!-- Mensaje -->
                    <% if (mensaje) { %>

                        <div class="alert alert-warning" role="alert">
                            <i class="bi bi-info-circle-fill me-2"></i>

                            <%= mensaje %>
                        </div>

                        <% } %>

                            <!-- Resultados -->
                            <div class="card border-0 shadow-sm">

                                <div class="card-body p-4">

                                    <div class="d-flex justify-content-between align-items-center mb-4">

                                        <h2 class="h5 mb-0">
                                            Resultados
                                        </h2>

                                        <span class="badge bg-secondary">
                                            Registros: <%= empleados.length %>
                                        </span>

                                    </div>

                                    <% if (empleados.length> 0) { %>

                                        <div class="table-responsive">

                                            <table class="table table-hover align-middle mb-0">

                                                <thead class="encabezado-tabla">

                                                    <tr>
                                                        <th>ID</th>
                                                        <th>Nombre</th>
                                                        <th>Cargo</th>
                                                        <th>Sueldo</th>
                                                    </tr>

                                                </thead>

                                                <tbody>

                                                    <% empleados.forEach(empleado=> { %>

                                                        <tr>

                                                            <td>
                                                                <%= empleado.id %>
                                                            </td>

                                                            <td>
                                                                <%= empleado.nombre %>
                                                            </td>

                                                            <td>
                                                                <%= empleado.cargo %>
                                                            </td>

                                                            <td>
                                                                $<%= Number(empleado.sueldo).toLocaleString("es-CL") %>
                                                            </td>

                                                        </tr>

                                                        <% }); %>

                                                </tbody>

                                            </table>

                                        </div>

                                        <% } else if (!mensaje) { %>

                                            <div class="alert alert-warning mb-0">

                                                <i class="bi bi-info-circle-fill me-2"></i>

                                                No existen empleados para mostrar.

                                            </div>

                                            <% } %>

                                </div>

                            </div>

                            <div class="mt-4">

                                <a href="/" class="btn btn-secondary">
                                    <i class="bi bi-arrow-left me-1"></i>
                                    Volver a empleados
                                </a>

                            </div>

                </div>

            </div>

        </main>

        <!-- JavaScript de Bootstrap -->
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>